---
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '../styles/global.css';
import { brand, copy, type Locale } from '../data/content';
import { privacyNotice, privacyPaths } from '../data/privacyNotice';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Seo from '../components/Seo.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const es = locale === 'es';
const t = privacyNotice[locale];
const other = es ? 'en' : 'es';
const home = `/${locale}/`;
const requestLink = `mailto:${brand.email}?subject=${encodeURIComponent(t.requestSubject)}`;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={`${t.title} — Artimex Bakery`} description={t.description} locale={locale} paths={privacyPaths} />
    <meta name="theme-color" content="#29231d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body id="top">
    <a class="skip-link" href="#privacy-content">{copy[locale].skip}</a>
    <header class="privacy-header section-wrap">
      <a class="brand" href={home} aria-label="Artimex Bakery"><Icon name="wheat" class="brand-mark" /><span><span class="brand-name">ARTIMEX</span><span class="brand-subtitle">ARTISAN MEXICAN BAKERY</span></span></a>
      <nav aria-label={es ? 'Navegación del aviso' : 'Notice navigation'}>
        <a class="return-home" href={home} aria-label={t.home}><span aria-hidden="true">←</span><span class="return-label">{t.home}</span></a>
        <a class="privacy-language" href={privacyPaths[other]} hreflang={other} lang={other} aria-label={es ? 'Read in English' : 'Leer en español'}>{other.toUpperCase()}</a>
      </nav>
    </header>
    <main id="privacy-content" class="section-wrap">
      <div class="privacy-hero"><p class="eyebrow">{t.eyebrow}</p><h1>{t.titleLead}<br /><em>{t.titleEm}</em></h1><p class="privacy-intro">{t.intro}</p><p class="notice-date"><time datetime={privacyNotice.updated}>{t.updated}</time></p></div>
      <aside class="notice-summary" aria-labelledby="summary-title"><h2 id="summary-title" class="eyebrow">{t.summaryTitle}</h2><dl>{t.summary.map(([title, text]) => <div><dt>{title}</dt><dd>{text}</dd></div>)}</dl></aside>
      <div class="privacy-layout">
        <aside class="privacy-sidebar">
          <nav aria-label={t.contents}><p class="eyebrow">{t.contents}</p><ol>{t.sections.map((section, i) => <li><a href={`#${section.id}`}><span>{String(i + 1).padStart(2, '0')}</span>{section.title}</a></li>)}</ol></nav>
          <div class="sidebar-contact"><p class="eyebrow">{t.contact}</p><a href={`mailto:${brand.email}`}>{brand.email}</a><a href={brand.phoneHref}>562-777-0924</a></div>
        </aside>
        <div class="legal-content">
          {t.sections.map((section, i) => <section id={section.id} aria-labelledby={`${section.id}-title`}>
            <p class="section-number">{String(i + 1).padStart(2, '0')}</p><h2 id={`${section.id}-title`}>{section.title}</h2>
            {section.paragraphs?.map(text => <p>{text}</p>)}
            {section.bullets && <ul>{section.bullets.map(text => <li>{text}</li>)}</ul>}
            {section.id === 'information' && <div class="information-categories"><h3>{t.categoriesTitle}</h3><dl>{t.categories.map(([title, text]) => <div><dt>{title}</dt><dd>{text}</dd></div>)}</dl></div>}
            {section.closing?.map(text => <p>{text}</p>)}
            {section.links && <div class="resource-links">{section.links.map(([label, href]) => <a href={href} target="_blank" rel="noopener noreferrer">{label}<span aria-hidden="true">↗</span></a>)}</div>}
            {section.id === 'privacy-rights' && <a class="button button-dark request-button" href={requestLink}>{t.request}<Icon /></a>}
          </section>)}
          <aside class="privacy-contact" aria-labelledby="privacy-contact-title"><p class="eyebrow">Artimex Bakery</p><h2 id="privacy-contact-title">{t.contact}</h2><p>{t.department}</p><address>{brand.address}<br />{brand.city}<br />{es ? 'Estados Unidos' : 'United States'}</address><dl><div><dt>Email</dt><dd><a href={`mailto:${brand.email}`}>{brand.email}</a></dd></div><div><dt>{t.phone}</dt><dd><a href={brand.phoneHref}>562-777-0924</a></dd></div><div><dt>FAX</dt><dd>562-777-9607</dd></div></dl></aside>
        </div>
      </div>
    </main>
    <Footer locale={locale} page="privacy" />
  </body>
</html>
<style>
  .privacy-header{display:flex;justify-content:space-between;align-items:center;gap:24px;min-height:102px;padding-top:22px;padding-bottom:22px;background:var(--ink);color:var(--ivory);position:sticky;top:0;z-index:30;}
  .privacy-header nav{display:flex;align-items:center;gap:28px;font-size:12px;}
  .return-home{display:inline-flex;align-items:center;gap:12px;min-height:44px;}
  .return-home>span:first-child{font-size:22px;color:#e0c8a2;}
  .privacy-language{display:flex;align-items:center;min-height:44px;padding:0 5px;}
  main{max-width:1440px;margin:0 auto;padding-top:75px;padding-bottom:90px;}
  .privacy-hero{max-width:830px;}
  .eyebrow{color:var(--muted);}
  h1{font-size:clamp(62px,7vw,96px);line-height:.95;letter-spacing:-.035em;margin-top:25px;}
  h1 em{color:#887051;}
  .privacy-intro{max-width:670px;margin-top:28px;color:var(--muted);font-size:15px;line-height:1.85;}
  .notice-date{margin-top:25px;color:var(--muted);font-size:11px;line-height:1.7;}
  .notice-summary{margin:42px 0 60px;padding:28px 30px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--paper);}
  .notice-summary h2{font-family:var(--sans);margin-bottom:23px;}
  .notice-summary dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:34px;margin:0;}
  .notice-summary dt{margin-bottom:10px;font-family:var(--serif);font-size:25px;}
  .notice-summary dd{margin:0;color:var(--muted);font-size:13px;line-height:1.8;}
  .privacy-layout{display:grid;grid-template-columns:245px minmax(0,1fr);gap:65px;align-items:start;}
  .privacy-sidebar{position:sticky;top:130px;}
  .privacy-sidebar ol{display:grid;gap:8px;margin-top:18px;padding:0;list-style:none;}
  .privacy-sidebar li a{display:grid;grid-template-columns:23px minmax(0,1fr);gap:9px;padding:5px 0;color:var(--muted);font-size:11px;line-height:1.6;}
  .privacy-sidebar li span{color:#887051;}
  .privacy-sidebar li a:hover{color:var(--ink);text-decoration:underline;text-underline-offset:4px;}
  .sidebar-contact{margin-top:28px;padding-top:23px;border-top:1px solid var(--line);}
  .sidebar-contact>a{display:block;width:fit-content;margin-top:12px;font-size:12px;text-decoration:underline;text-underline-offset:4px;}
  .legal-content{min-width:0;}
  .legal-content>section{padding-bottom:36px;margin-bottom:35px;border-bottom:1px solid var(--line);scroll-margin-top:30px;}
  .section-number{margin-bottom:11px;color:#887051;font-size:10px;}
  .legal-content h2{margin-bottom:23px;font-size:clamp(30px,2.7vw,40px);line-height:1.12;letter-spacing:-.025em;}
  .legal-content section>p:not(.section-number),.legal-content li{color:#62594e;font-size:14px;line-height:1.85;}
  .legal-content section>p:not(.section-number){margin-top:16px;}
  .legal-content ul{display:grid;gap:11px;padding-left:19px;margin:21px 0;}
  .legal-content li::marker{color:#887051;}
  .information-categories{margin-top:27px;padding:25px;background:var(--paper);border-left:2px solid var(--gold);}
  .information-categories h3{margin-bottom:20px;font-size:28px;line-height:1.2;}
  .information-categories dl{display:grid;gap:20px;margin:0;}
  .information-categories dt{margin-bottom:6px;font-size:13px;font-weight:500;line-height:1.6;}
  .information-categories dd{margin:0;color:#62594e;font-size:13px;line-height:1.85;}
  .resource-links{display:flex;flex-wrap:wrap;gap:12px 25px;margin-top:23px;}
  .resource-links a{display:inline-flex;align-items:baseline;gap:8px;font-size:12px;line-height:1.7;text-decoration:underline;text-underline-offset:4px;}
  .request-button{margin-top:26px;white-space:normal;line-height:1.5;}
  .request-button svg{width:20px;height:20px;}
  .privacy-contact{padding:32px;background:var(--ink);color:var(--ivory);}
  .privacy-contact .eyebrow{color:#e0c8a2;}
  .privacy-contact h2{margin-top:15px;}
  .privacy-contact>p:not(.eyebrow){font-size:13px;line-height:1.7;}
  .privacy-contact address{margin-top:15px;margin-bottom:25px;color:#d0c4b5;font-size:13px;line-height:1.8;}
  .privacy-contact dl{display:grid;gap:9px;margin:0;}
  .privacy-contact dl>div{display:grid;grid-template-columns:68px minmax(0,1fr);gap:12px;font-size:13px;line-height:1.6;}
  .privacy-contact dt{color:#e0c8a2;}
  .privacy-contact dd{margin:0;overflow-wrap:anywhere;}
  .privacy-contact a{text-decoration:underline;text-underline-offset:3px;}
  @media(max-width:1100px){.privacy-layout{grid-template-columns:200px minmax(0,1fr);gap:35px;}}
  @media(max-width:820px){main{padding-top:55px;padding-bottom:65px;}.privacy-layout{grid-template-columns:1fr;gap:40px;}.privacy-sidebar{position:static;padding-bottom:30px;border-bottom:1px solid var(--line);}.privacy-sidebar ol{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 23px;}.sidebar-contact{display:none;}.notice-summary{margin-bottom:35px;padding:25px;}.notice-summary dl{grid-template-columns:1fr;gap:20px;}.notice-summary dt{margin-bottom:6px;}}
  @media(max-width:650px){.privacy-header{gap:15px;min-height:88px;padding-top:15px;padding-bottom:15px;}.privacy-header nav{gap:12px;}.return-label{display:none;}.return-home{gap:0;}.privacy-sidebar ol{grid-template-columns:1fr;}.privacy-contact{padding:25px;}.privacy-contact dl>div{grid-template-columns:58px minmax(0,1fr);gap:8px;font-size:12px;}.request-button{width:100%;font-size:11px;gap:20px;}.information-categories{padding:20px;}.privacy-hero h1{font-size:clamp(58px,14vw,80px);}}
</style>
