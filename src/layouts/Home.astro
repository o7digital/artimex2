---
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '../styles/global.css';
import { brand, copy, type Locale } from '../data/content';
import Header from '../components/Header.astro';
import Hero from '../components/Hero';
import Collection from '../components/Collection';
import Contact from '../components/Contact.astro';
import Icon from '../components/Icon.astro';
import Story from '../components/Story.astro';
import Footer from '../components/Footer.astro';
import Careers from '../components/Careers.astro';
import Restaurants from '../components/Restaurants.astro';
import BreadDetails from '../components/BreadDetails.astro';
import Seo from '../components/Seo.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import ContactForm from '../components/ContactForm.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <GoogleAnalytics />
    <Seo title={t.title} description={t.description} locale={locale} paths={{ es: '/es/', en: '/en/' }} business />
    <meta name="theme-color" content="#29231d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="image" href="/images/hero-bread.webp" media="(min-width: 651px)" fetchpriority="high" />
    <link rel="preload" as="image" href="/images/hero-bread-mobile.webp" media="(max-width: 650px)" fetchpriority="high" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header locale={locale} />
    <main id="main">
      <Hero locale={locale} client:load />
      <section class="essence-intro section-wrap" id="essence">
        <p class="eyebrow reveal">{t.intro.eyebrow}</p>
        <h2 class="statement reveal">{t.intro.first}<br /><em>{t.intro.second}</em></h2>
        <div class="intro-foot reveal"><span /><Icon name="wheat" /><span /></div>
        <p class="intro-note reveal">{t.intro.note}</p>
      </section>
      <Story locale={locale} />
      <section class="collection-section section-wrap" id="collection">
        <div class="section-heading reveal"><div><p class="eyebrow">{t.collection.eyebrow}</p><h2>{t.collection.first}<br /><em>{t.collection.second}</em></h2></div><p>{t.collection.body}</p></div>
        <Collection locale={locale} client:visible />
      </section>
      <section class="business-section" id="business">
        <div class="business-texture" aria-hidden="true"><img src="/images/hero-bread.webp" width="1672" height="941" alt="" loading="lazy" /></div>
        <div class="business-inner section-wrap"><div class="business-title reveal"><p class="eyebrow">{t.business.eyebrow}</p><h2>{t.business.first}<br /><em>{t.business.second}</em></h2><button class="button button-ivory" data-contact>{t.business.link}<Icon /></button></div><div class="business-copy reveal"><p>{t.business.body}</p><div class="business-list">{t.business.items.map((item, i) => <div>{i === 0 ? <button type="button" data-restaurants aria-haspopup="dialog" aria-controls="restaurants-dialog"><span>0{i + 1}</span><span>{item}</span><Icon /></button> : <><span>0{i + 1}</span><span>{item}</span><Icon /></>}</div>)}</div><p class="business-note">{t.business.sub}</p></div></div>
      </section>
      <Careers locale={locale} />
      <section class="contact-section section-wrap" id="contact">
        <div class="location-heading reveal"><p class="eyebrow">{t.location.eyebrow}</p><h2>{t.location.first}<br /><em>{t.location.second}</em></h2></div>
        <div class="location-details reveal"><div><p class="eyebrow">{t.location.address}</p><address>{brand.address}<br />{brand.city}</address><a class="text-link" href={brand.map} target="_blank" rel="noopener noreferrer">{t.location.directions}<Icon /></a></div><div><p class="eyebrow">{t.location.sales}</p><a class="contact-email" href={`mailto:${brand.email}`}>{brand.email}</a><a class="contact-phone" href={brand.phoneHref}>{brand.phone}</a><button class="text-link" data-contact>{t.location.contact}<Icon /></button></div></div>
        <div class="contact-inline"><p class="eyebrow">{t.contact.eyebrow}</p><h3>{t.contact.title}</h3><p class="contact-intro">{t.contact.body}</p><ContactForm locale={locale} id="contact-section-form" /></div>
      </section>
    </main>
    <Footer locale={locale} />
    <Contact locale={locale} />
    <Restaurants locale={locale} />
    <BreadDetails />
    <script>
      const oldSections: Record<string, string> = { '#masa-home': '#top', '#masa-story': '#story', '#masa-collection': '#collection' };
      const restoreSection = () => {
        if (location.hash === '#masa-box') { location.replace('/box/#masa-box'); return; }
        const target = oldSections[location.hash];
        if (target) { history.replaceState(null, '', target); document.querySelector(target)?.scrollIntoView(); }
      };
      restoreSection();
      window.addEventListener('hashchange', restoreSection);
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver((entries) => { entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }); }, { threshold: 0.06 });
        document.querySelectorAll<HTMLElement>('.reveal').forEach((element) => { if (element.getBoundingClientRect().top > window.innerHeight) element.classList.add('will-reveal'); observer.observe(element); });
      }
    </script>
  </body>
</html>
