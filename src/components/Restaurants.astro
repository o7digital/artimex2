---
import { restaurants } from '../data/restaurants';
import { type Locale } from '../data/content';
import Icon from './Icon.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const es = locale === 'es';
---
<dialog class="restaurants-dialog" id="restaurants-dialog" aria-labelledby="restaurants-title">
  <button class="dialog-close" data-restaurants-close aria-label={es ? 'Cerrar restaurantes' : 'Close restaurants'}><Icon name="close" /></button>
  <p class="eyebrow">EL GALLO GIRO</p>
  <h2 id="restaurants-title">{es ? 'Nuestros restaurantes.' : 'Our restaurants.'}</h2>
  <div class="restaurant-grid">
    {restaurants.map((restaurant, i) => <article class="restaurant-card">
      <p class="eyebrow">EL GALLO GIRO · {String(i + 1).padStart(2, '0')}</p>
      <h3>{restaurant.name}</h3>
      <address>{restaurant.address}<br />{restaurant.city}</address>
      <a class="text-link" href={restaurant.map} target="_blank" rel="noopener noreferrer" aria-label={`${es ? 'Cómo llegar a' : 'Directions to'} El Gallo Giro ${restaurant.name}`}>{es ? 'Cómo llegar' : 'Get directions'}<Icon /></a>
    </article>)}
  </div>
</dialog>
<script>
  const dialog = document.getElementById('restaurants-dialog') as HTMLDialogElement;
  let trigger: HTMLElement | null = null;
  document.querySelectorAll<HTMLElement>('[data-restaurants]').forEach(button => {
    button.addEventListener('click', () => {
      trigger = button;
      dialog.showModal();
      document.body.classList.add('dialog-open');
    });
  });
  dialog.querySelector('[data-restaurants-close]')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => {
    if (!document.querySelector('dialog[open]')) document.body.classList.remove('dialog-open');
    trigger?.focus();
  });
</script>
