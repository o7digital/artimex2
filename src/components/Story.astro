---
import { copy, type Locale } from '../data/content';
import Icon from './Icon.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale].story;
---
<section class="story-content section-wrap" id="story" aria-labelledby="story-title">
  <div class="story-section">
    <div class="story-photo reveal">
      <img src="/images/atelier.webp" alt={locale === 'es' ? 'Manos trabajando la masa sobre una mesa de madera; imagen ilustrativa del oficio panadero.' : 'Hands shaping dough on a wooden table; an illustrative image of the baker’s craft.'} width="960" height="1200" loading="lazy" decoding="async" />
      <span class="photo-caption">{t.portraitCaption}</span>
      <div class="artisan-stamp"><span>{t.stamp[0]}</span><Icon name="wheat" /><span>{t.stamp[1]}</span></div>
    </div>
    <div class="story-copy reveal">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="story-title">{t.title}<br /><em>{t.titleEm}</em></h2>
      <p>{t.introduction}</p>
      <div class="story-origin">
        <p class="eyebrow">{t.originEyebrow}</p>
        <h3>{t.originTitle}</h3>
        <p>{t.originText}</p>
      </div>
      <ul class="story-principles" role="list">{t.principles.map(principle => <li>{principle}</li>)}</ul>
      <a class="text-link" href="#collection">{t.link}<Icon /></a>
      <span class="story-signature" aria-hidden="true">Artimex</span>
    </div>
  </div>
  <div class="story-craft reveal">
    <div class="story-heading"><p class="eyebrow">{t.craftEyebrow}</p><h3>{t.craftTitle}</h3></div>
    <ol>
      {t.craft.map((detail, i) => <li><span class="story-number" aria-hidden="true">0{i + 1}</span><h4>{detail.title}</h4><p>{detail.text}</p></li>)}
    </ol>
  </div>
  <div class="story-audiences">
    {[t.fresh, t.wholesale].map((audience, i) => <article class="story-audience reveal">
      <p class="eyebrow">{audience.eyebrow}</p>
      <h3>{audience.title}</h3>
      <p>{audience.introduction}</p>
      <dl>{audience.details.map(detail => <div><dt>{detail.title}</dt><dd>{detail.text}</dd></div>)}</dl>
      <div class="story-actions">
        <a class="text-link" href={i === 0 ? '#collection' : '#business'}>{i === 0 ? audience.link : copy[locale].nav.business}<Icon /></a>
        {i === 1 && <button class="text-link" data-contact>{t.wholesale.contact}<Icon /></button>}
      </div>
    </article>)}
  </div>
</section>
<style>
  .story-content{padding-bottom:130px;}
  .story-section{padding-bottom:0;}
  .story-origin{margin-top:28px;padding-top:24px;border-top:1px solid var(--line);}
  .eyebrow{color:var(--muted);}
  .story-origin h3{margin-top:12px;font-size:32px;line-height:1.15;letter-spacing:-.02em;}
  .story-origin>p:last-child{margin-top:16px;max-width:385px;font-size:13px;line-height:1.95;color:var(--muted);}
  .story-principles{display:flex;flex-wrap:wrap;gap:12px 20px;list-style:none;padding:0;margin-top:26px;}
  .story-principles li{display:flex;align-items:center;gap:8px;font-size:10px;color:#887051;}
  .story-principles li::before{content:'';width:4px;height:4px;background:currentColor;border-radius:50%;flex-shrink:0;}
  .photo-caption{right:100px;max-width:265px;line-height:1.4;}
  .story-craft{margin-top:100px;padding-top:60px;border-top:1px solid var(--line);}
  .story-heading{max-width:570px;}
  .story-heading h3,.story-audience h3{font-size:clamp(40px,4vw,62px);line-height:1.05;letter-spacing:-.028em;margin-top:20px;}
  .story-craft ol{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px;list-style:none;padding:0;margin-top:45px;}
  .story-craft li{border-top:1px solid var(--line);padding-top:22px;}
  .story-number{font-size:9px;color:#887051;}
  .story-craft h4{font-size:29px;line-height:1.15;margin-top:18px;}
  .story-craft li>p,.story-audience>p:not(.eyebrow){font-size:13px;line-height:1.9;color:var(--muted);margin-top:20px;}
  .story-audiences{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8vw;margin-top:85px;}
  .story-audience{border-top:1px solid var(--line);padding-top:35px;min-width:0;}
  .story-audience dl{margin-top:27px;}
  .story-audience dl>div{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:22px;border-top:1px solid var(--line);padding:18px 0;}
  .story-audience dt{font-family:var(--serif);font-size:23px;line-height:1.2;}
  .story-audience dd{margin:0;font-size:12px;line-height:1.8;color:var(--muted);}
  .story-actions{display:flex;flex-wrap:wrap;align-items:center;gap:15px 25px;margin-top:12px;}
  @media(max-width:1000px){.story-craft ol{gap:25px;}.story-craft h4{font-size:26px;}.story-audience dl>div{grid-template-columns:1fr;gap:8px;}.story-origin>p:last-child{font-size:12px;}}
  @media(max-width:700px){.story-content{padding-bottom:80px;}.story-craft{margin-top:65px;padding-top:40px;}.story-craft ol{grid-template-columns:1fr;gap:28px;margin-top:30px;}.story-craft h4{font-size:30px;margin-top:12px;}.story-audiences{grid-template-columns:1fr;gap:50px;margin-top:55px;}.story-origin>p:last-child{font-size:13px;max-width:480px;}.story-origin h3{font-size:30px;}.photo-caption{max-width:175px;right:90px;}}
</style>
