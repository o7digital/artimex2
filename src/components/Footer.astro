---
import { brand, copy, type Locale } from '../data/content';
import { privacyNotice, privacyPaths } from '../data/privacyNotice';
import { shopPaths } from '../data/commerce';
import { footerKeywords } from '../data/targetKeywords';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
interface Props { locale: Locale; page?: 'home' | 'privacy'; }
const { locale, page = 'home' } = Astro.props;
const t = copy[locale];
const es = locale === 'es';
const home = `/${locale}/`;
const languages = page === 'privacy' ? privacyPaths : { es: '/es/', en: '/en/' };
const explore = es ? 'Explora Artimex' : 'Explore Artimex';
const links = [
  { label: es ? 'Inicio' : 'Home', href: home },
  { label: t.nav.story, href: `${home}#story` },
  { label: t.nav.collection, href: `${home}#collection` },
  { label: t.nav.shop, href: shopPaths[locale] },
  { label: t.nav.business, href: `${home}#business` },
  { label: t.nav.careers, href: `${home}#careers` },
  { label: t.nav.vendors, href: `${home}#vendors` },
  { label: t.nav.contact, href: `${home}#contact` },
];
---
<footer class="site-footer section-wrap" id="site-footer">
  <div class="footer-main">
    <div class="footer-identity">
      <a class="brand" href={home} aria-label="Artimex Bakery"><Logo class="footer-logo" width={440} /></a>
      <p>{es ? 'Auténtico pan mexicano, elaborado con oficio y calidad constante.' : 'Authentic Mexican bread, made with craft and built for consistency.'}</p>
      <span class="eyebrow">ARTIMEX ARTISAN MEXICAN BAKERY</span>
    </div>
    <nav class="footer-explore" aria-label={explore}>
      <h2 class="eyebrow">{explore}</h2>
      {links.map(link => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="footer-contact">
      <h2 class="eyebrow">{es ? 'Conversemos' : 'Let’s talk'}</h2>
      <p class="footer-department">{es ? 'Departamento de ventas de Artimex Bakery' : 'Artimex Bakery Sales Department'}</p>
      <address>{brand.address}<br />{brand.city}<br />{es ? 'Estados Unidos' : 'United States'}</address>
      <a class="footer-email" href={`mailto:${brand.email}`}>{brand.email}<Icon /></a>
      <p class="footer-phone">
        <a href={brand.phoneHref} aria-label={`${es ? 'Teléfono' : 'Phone'}: 562-777-0924`}><Icon name="phone" />562-777-0924</a>
        <span class="footer-fax"><span class="sr-only">Fax: </span><Icon name="fax" />{brand.fax}</span>
      </p>
    </div>
  </div>
  <div class="footer-top"><span>{t.footer.tagline}</span><a href="#top" class="back-to-top">{t.location.top}<Icon name="down" /></a></div>
  <div class="footer-bottom">
    <span class="footer-rights">© {new Date().getFullYear()} {t.footer.rights}</span>
    <div class="footer-links"><a href={privacyPaths[locale]}>{privacyNotice[locale].title}</a></div>
    <a class="footer-credit" href={`https://www.o7digital.com/${locale}/`}>{es ? 'Hecho por O7 Digital' : 'Made by O7 Digital'}</a>
    <div class="footer-languages"><a href={languages.es} lang="es" hreflang="es" data-language-link aria-current={locale === 'es' ? 'page' : undefined}>ES</a><span>/</span><a href={languages.en} lang="en" hreflang="en" data-language-link aria-current={locale === 'en' ? 'page' : undefined}>EN</a></div>
  </div>
  <div class="footer-keywords" aria-label={es ? 'Pan mexicano para tu negocio' : 'Mexican bread for your business'}>
    <ul role="list">
      {footerKeywords(locale).map(keyword => <li>{keyword}</li>)}
    </ul>
    <p>{es ? 'Consulta con nuestro equipo las opciones de productos y entrega para tu ubicación.' : 'Ask our team about product and delivery options for your location.'}</p>
  </div>
</footer>
<script>
  import '../scripts/language-navigation';
</script>

<style>
  .footer-keywords{margin-top:24px;padding-top:20px;border-top:1px solid rgba(235,219,194,.2);color:#d0c4b5;font-size:11.5px;line-height:1.9;text-align:center;}
  .footer-keywords ul{list-style:none;margin:0;padding:0;text-wrap:pretty;}
  .footer-keywords li{display:inline;overflow-wrap:anywhere;}
  .footer-keywords li:not(:last-child)::after{content:' · ';white-space:pre;}
  .footer-keywords p{margin-top:12px;font-size:12px;}
  @media(max-width:700px){.footer-keywords{font-size:11px;line-height:2;}}
</style>
